{
  "name": "jungle-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch src/main.ts",
    "frontend": "bun run frontend/server.ts",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 120000",
    "test:concurrency": "bun test test/concurrency --timeout 120000",
    "test:all": "bun test --timeout 120000",
    "migration:up": "bunx mikro-orm migration:up",
    "migration:down": "bunx mikro-orm migration:down",
    "infra:up": "docker compose up -d postgres",
    "infra:down": "docker compose down -v",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down -v"
  },
  "mikro-orm": {
    "useTsNode": false,
    "configPaths": [
      "./src/mikro-orm.config.ts"
    ]
  },
  "dependencies": {
    "@mikro-orm/core": "^6.4.2",
    "@mikro-orm/migrations": "^6.4.2",
    "@mikro-orm/postgresql": "^6.4.2",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "decimal.js": "^10.4.3",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.4.2",
    "@types/bun": "^1.1.14",
    "@types/express": "^5.0.6",
    "typescript": "^5.7.2"
  }
}
